{
  "dynamic_renders": [],
  "loader": "gtceu:machine",
  "machine": "gtceu:uiv_rotor_holder",
  "multipart": [
    {
      "apply": {
        "parent": "gtceu:block/machine/template/rotor_holder/block",
        "textures": {
          "bottom": "gtceu:block/casings/voltage/uiv/bottom",
          "side": "gtceu:block/casings/voltage/uiv/side",
          "top": "gtceu:block/casings/voltage/uiv/top"
        }
      }
    },
    {
      "apply": "gtceu:block/machine/template/rotor_holder/overlay",
      "when": {
        "is_formed": "true"
      }
    },
    {
      "apply": "gtceu:block/machine/template/rotor_holder/rotor_idle",
      "when": {
        "emissive_rotor": "false",
        "has_rotor": "true",
        "is_formed": "true",
        "rotor_spinning": "false"
      }
    },
    {
      "apply": "gtceu:block/machine/template/rotor_holder/rotor_idle_emissive",
      "when": {
        "emissive_rotor": "true",
        "has_rotor": "true",
        "is_formed": "true",
        "rotor_spinning": "false"
      }
    },
    {
      "apply": "gtceu:block/machine/template/rotor_holder/rotor_spinning",
      "when": {
        "emissive_rotor": "false",
        "has_rotor": "true",
        "is_formed": "true",
        "rotor_spinning": "true"
      }
    },
    {
      "apply": "gtceu:block/machine/template/rotor_holder/rotor_spinning_emissive",
      "when": {
        "emissive_rotor": "true",
        "has_rotor": "true",
        "is_formed": "true",
        "rotor_spinning": "true"
      }
    }
  ]
}